FUNCTION_BLOCK irritability

VAR_INPUT
    sugar : REAL;      // Şeker miktarı (gram/gün) [0, 30]
    age   : REAL;      // Yaş (yıl) [0, 18]
    gender : REAL;     // Cinsiyet (0=Erkek, 1=Kız) [0, 1]
END_VAR

VAR_OUTPUT
    irritability : REAL; // Sinirlilik seviyesi (%) [0, 100]
END_VAR

FUZZIFY sugar
    TERM low := (0, 1) (10, 0);          // Az şeker
    TERM medium := (8, 0) (14, 1) (18, 0); // Orta şeker
    TERM high := (15, 0) (30, 1);        // Çok şeker
END_FUZZIFY

FUZZIFY age
    TERM toddler := (0, 1) (3, 0);        // 0-3 yaş
    TERM child := (3, 0) (6, 1) (10, 0);   // 3-10 yaş
    TERM adolescent := (10, 0) (18, 1);   // 10-18 yaş
END_FUZZIFY

// Cinsiyet (Kız/Erkek) tanımı
FUZZIFY gender
    TERM erkek := (0, 1) (0.5, 0);
    TERM kiz := (0.5, 0) (1, 1);
END_FUZZIFY

DEFUZZIFY irritability
    TERM low := (0, 0) (40, 1);
    TERM medium := (30, 0) (60, 1) (80, 0);
    TERM high := (70, 0) (100, 1);
    METHOD : COG; // Testler için MOM veya BOA olarak değiştirilecektir.
    DEFAULT := 0;
END_DEFUZZIFY

    RULEBLOCK No1
    AND : MIN;
    ACT : MIN;
    ACCU : MAX;

    // 18 Kurallar (3 şeker × 3 yaş × 2 cinsiyet)

    // Grup 1: Erkek (gender IS erkek) - Sinirlilik Skoru Biraz Daha DÜŞÜK/NORMAL
    // DÜŞÜK ŞEKER
    RULE 1 : IF sugar IS low AND age IS toddler AND gender IS erkek THEN irritability IS medium;
    RULE 3 : IF sugar IS medium AND age IS toddler AND gender IS erkek THEN irritability IS medium; // Kizda high yapilabilir
    RULE 5 : IF sugar IS high AND age IS toddler AND gender IS erkek THEN irritability IS high;

    RULE 7 : IF sugar IS low AND age IS child AND gender IS erkek THEN irritability IS low; // Kizda medium yapilabilir
    RULE 9 : IF sugar IS medium AND age IS child AND gender IS erkek THEN irritability IS medium;
    RULE 11 : IF sugar IS high AND age IS child AND gender IS erkek THEN irritability IS high;

    RULE 13 : IF sugar IS low AND age IS adolescent AND gender IS erkek THEN irritability IS medium;
    RULE 15 : IF sugar IS medium AND age IS adolescent AND gender IS erkek THEN irritability IS high;
    RULE 17 : IF sugar IS high AND age IS adolescent AND gender IS erkek THEN irritability IS high;
    
    // Grup 2: Kız (gender IS kiz) - Sinirlilik Skoru Biraz Daha YÜKSEK (Rapora Uyumlu)
    // DÜŞÜK ŞEKER
    RULE 2 : IF sugar IS low AND age IS toddler AND gender IS kiz THEN irritability IS medium; // Erkekle ayni
    RULE 4 : IF sugar IS medium AND age IS toddler AND gender IS kiz THEN irritability IS high; // Erkekten 1 kademe yüksek
    RULE 6 : IF sugar IS high AND age IS toddler AND gender IS kiz THEN irritability IS high; // Erkekle ayni

    RULE 8 : IF sugar IS low AND age IS child AND gender IS kiz THEN irritability IS medium; // Erkekten 1 kademe yüksek
    RULE 10 : IF sugar IS medium AND age IS child AND gender IS kiz THEN irritability IS high; // Erkekten 1 kademe yüksek
    RULE 12 : IF sugar IS high AND age IS child AND gender IS kiz THEN irritability IS high; // Erkekle ayni

    RULE 14 : IF sugar IS low AND age IS adolescent AND gender IS kiz THEN irritability IS medium; // Erkekle ayni
    RULE 16 : IF sugar IS medium AND age IS adolescent AND gender IS kiz THEN irritability IS high; // Erkekle ayni
    RULE 18 : IF sugar IS high AND age IS adolescent AND gender IS kiz THEN irritability IS high; // Erkekle ayni

END_RULEBLOCK

END_FUNCTION_BLOCK